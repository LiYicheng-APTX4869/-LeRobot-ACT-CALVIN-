# LeRobot ACT CALVIN 泛化实验的公共配置。
# scripts/*.sh 会读取本文件；如有需要，可在命令行中覆盖这些变量。

PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
DATA_ROOT="${DATA_ROOT:-${PROJECT_ROOT}/data/calvin-lerobot}"
OUTPUT_ROOT="${OUTPUT_ROOT:-${PROJECT_ROOT}/outputs}"
CACHE_ROOT="${CACHE_ROOT:-${OUTPUT_ROOT}/cache}"

HF_DATASET_ID="${HF_DATASET_ID:-xiaoma26/calvin-lerobot}"
BASE_REPO_ID="${BASE_REPO_ID:-local/calvin_splitA}"
JOINT_REPO_ID="${JOINT_REPO_ID:-local/calvin_splitABC}"

GPU_IDS="${GPU_IDS:-0,1}"
NUM_GPUS="${NUM_GPUS:-2}"
SEED="${SEED:-42}"

TRAIN_STEPS="${TRAIN_STEPS:-100000}"
BATCH_SIZE="${BATCH_SIZE:-64}"
NUM_WORKERS="${NUM_WORKERS:-8}"
SAVE_FREQ="${SAVE_FREQ:-10000}"
LOG_FREQ="${LOG_FREQ:-100}"
EVAL_FREQ="${EVAL_FREQ:-10000}"
LEARNING_RATE="${LEARNING_RATE:-1e-5}"

ACT_CHUNK_SIZE="${ACT_CHUNK_SIZE:-100}"
ACT_N_ACTION_STEPS="${ACT_N_ACTION_STEPS:-100}"

LEROBOT_TRAIN_BIN="${LEROBOT_TRAIN_BIN:-lerobot-train}"
LEROBOT_EVAL_BIN="${LEROBOT_EVAL_BIN:-lerobot-eval}"
PYTHON_BIN="${PYTHON_BIN:-python}"
LEROBOT_PACKAGE="${LEROBOT_PACKAGE:-lerobot[calvin]}"
INSTALL_CONDA_BUILD_TOOLS="${INSTALL_CONDA_BUILD_TOOLS:-0}"
USE_COMPAT_TRAIN="${USE_COMPAT_TRAIN:-1}"

# 额外参数会原样追加到 LeRobot 命令末尾。
COMMON_TRAIN_ARGS="${COMMON_TRAIN_ARGS:-}"
COMMON_EVAL_ARGS="${COMMON_EVAL_ARGS:-}"
